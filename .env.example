# ==========================================================
# Contoh konfigurasi lingkungan untuk Docker Compose
# ----------------------------------------------------------
# Cara pakai:
#   1. Salin file ini menjadi ".env"  (di Windows: copy .env.example .env)
#   2. Ubah nilainya sesuai kebutuhan servermu
#   3. Jalankan: docker compose up -d --build
#
# File ".env" asli tidak ikut ke Git (sudah ada di .gitignore), sedangkan
# ".env.example" ini sengaja ikut agar pengingat konfigurasinya tidak hilang.
# ==========================================================

# Port yang dibuka di VPS / server. Buka http://IP-SERVER:<APP_PORT>
# Jika di belakang reverse proxy (Nginx/Caddy), biasanya cukup "127.0.0.1:8080"
# agar port tidak terekspos langsung ke internet — tulis lengkap termasuk
# alamat bind-nya, misalnya: APP_PORT=127.0.0.1:8080
APP_PORT=8080
